              "pattern": "\\bJOIN\\s+customers\\b",
              "error": "Join the orders and customers tables."
            },
            {
              "pattern": "\\bstatus\\s*=\\s*['\"]Delivered['\"]",
              "error": "Filter to Delivered orders."
            },
            {
              "pattern": "\\bamount\\s*>=\\s*500\\b",
              "error": "Add the amount >= 500 filter."
            },
            {
              "pattern": "\\bGROUP\\s+BY\\b",
              "error": "Group rows by customer."
            },
            {
              "pattern": "\\bHAVING\\s+COUNT\\s*\\(\\s*\\*\\s*\\)\\s*>=\\s*2",
              "error": "Keep only customers with at least two orders."
            },
            {
              "pattern": "\\bSUM\\s*\\(",
              "error": "Sum the order amounts."
            },
            {
              "pattern": "\\bORDER\\s+BY\\b[^;]*\\bDESC",
              "error": "Sort total amount descending."
            }
          ]
        },
