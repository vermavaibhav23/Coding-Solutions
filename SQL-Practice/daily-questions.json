          ],
          "task": [
            "Find customers who have at least 2 Delivered orders.",
            "Only count orders with amount >= 500.",
            "Display customer_name, delivered_orders and total_amount.",
            "Sort by total_amount descending."
          ],
          "output": {
            "headers": [
              "customer_name",
              "delivered_orders",
              "total_amount"
            ],
            "rows": [
              [
                "Asha",
                2,
                2800
              ],
              [
                "Kiran",
                2,
                1600
              ],
              [
                "Rahul",
                2,
                1100
              ]
            ]
          },
          "hint": "Join the two tables using customer_id. Filter rows before grouping; use HAVING for the minimum order count.",
          "solution": "SELECT c.name AS customer_name,\n       COUNT(*) AS delivered_orders,\n       SUM(o.amount) AS total_amount\nFROM orders o\nJOIN customers c ON c.customer_id = o.customer_id\nWHERE o.status = 'Delivered' AND o.amount >= 500\nGROUP BY c.customer_id, c.name\nHAVING COUNT(*) >= 2\nORDER BY total_amount DESC;",
          "steps": [
            "JOIN matches every order to its customer.",
            "WHERE removes Cancelled orders (102 and 109) and orders below 500.",
            "GROUP BY customer_id and name forms a distinct group per customer.",
            "COUNT(*) and SUM(amount) produce Asha (2, 2800), Kiran (2, 1600), Meera (1, 2500), Rahul (2, 1100).",
            "HAVING removes Meera because she has only one qualifying order.",
            "ORDER BY sorts the remaining customers by total_amount descending."
          ],
          "initial": "SELECT c.name as customer_name, COUNT(*) AS delivered_orders, SUM(o.amount) AS total_amount\nFROM orders o\nLEFT JOIN customers c ON o.customer_id = c.customer_id\nWHERE o.status = 'Delivered' AND o.amount >= 500\nGROUP BY c.name, c.customer_id\nHAVING COUNT(*) >= 2\nORDER BY SUM(o.amount) DESC",
          "solvedInitially": true,
          "checks": [
