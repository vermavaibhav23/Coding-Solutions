                300
              ]
            ]
          },
          "hint": "In a CTE, use ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY payment_date DESC, payment_id DESC). Then filter the numbered rows in an outer SELECT.",
          "solution": "WITH ranked_payments AS (\n    SELECT payment_id, customer_id, payment_date, amount,\n           ROW_NUMBER() OVER (\n               PARTITION BY customer_id\n               ORDER BY payment_date DESC, payment_id DESC\n           ) AS rn\n    FROM payments\n)\nSELECT customer_id, payment_id, payment_date, amount\nFROM ranked_payments\nWHERE rn <= 2\nORDER BY customer_id ASC, payment_date DESC, payment_id DESC;",
          "steps": [
