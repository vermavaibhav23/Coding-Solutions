          ],
          "intro": "Each row in payments represents a separate payment. A customer can have more than two payments or only one payment, and multiple payments can happen on the same date.",
          "tables": [
            {
              "name": "payments",
              "headers": [
                "payment_id",
                "customer_id",
                "payment_date",
                "amount"
              ],
              "rows": [
